# Copy to .env (gitignored) and fill in. Loaded automatically by `just`
# recipes; for direct runs use `uv run --env-file .env hdh agent`.

# Anthropic API key for `hdh agent` and `hdh narrative --llm`
# Get one at https://platform.claude.com/ (or use `ant auth login` instead —
# the SDK picks up the profile automatically, no key needed here).
ANTHROPIC_API_KEY=

# Optional: override the agent's model (default: claude-opus-5)
# HDH_AGENT_MODEL=claude-opus-5

# Optional: trace database (default: sqlite at ~/.hdh/traces.db).
# Any SQLAlchemy URL works, e.g. postgresql://user:pass@host/hdh_traces
# HDH_TRACE_DB=
HDH_DB_URL=postgresql+psycopg://hdh:hdh@localhost:5433/hdh

# Optional: daily token quotas enforced by the pipeline guardrails
# HDH_QUOTA_INPUT_TOKENS=500000
# HDH_QUOTA_OUTPUT_TOKENS=100000

# Optional: clinical database URL. When set, every hdh command uses this
# instead of the SQLite file. `just deps` starts a matching local container
# (values below are its local-container defaults, not secrets); move an
# existing SQLite dataset across with `hdh migrate`.
# HDH_DB_URL=postgresql+psycopg://hdh:hdh@localhost:5433/hdh

# Optional: Redis (started by `just deps`). Reserved as the future Celery
# broker/beat backend — nothing connects to it yet.
# HDH_REDIS_URL=redis://localhost:6379/0
