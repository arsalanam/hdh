# Copy to .env (gitignored) and fill in. Loaded automatically by `just`
# recipes; for direct runs use `uv run --env-file .env hdh agent`.

# Anthropic API key for `hdh agent` and `hdh narrative --llm`
# Get one at https://platform.claude.com/ (or use `ant auth login` instead —
# the SDK picks up the profile automatically, no key needed here).
ANTHROPIC_API_KEY=

# Optional: override the agent's model (default: claude-opus-5)
# HDH_AGENT_MODEL=claude-opus-5

# Optional: trace database (default: sqlite at ~/.hdh/traces.db).
# Any SQLAlchemy URL works, e.g. postgresql://user:pass@host/hdh_traces
# HDH_TRACE_DB=
HDH_DB_URL=postgresql+psycopg://hdh:hdh@localhost:5433/hdh

# Optional: daily token quotas enforced by the pipeline guardrails
# HDH_QUOTA_INPUT_TOKENS=500000
# HDH_QUOTA_OUTPUT_TOKENS=100000

# Optional: clinical database URL. When set, every hdh command uses this
# instead of the SQLite file. `just deps` starts a matching local container
# (values below are its local-container defaults, not secrets); move an
# existing SQLite dataset across with `hdh migrate`.
# HDH_DB_URL=postgresql+psycopg://hdh:hdh@localhost:5433/hdh

# Optional: Redis (started by `just deps`). Reserved as the future Celery
# broker/beat backend — nothing connects to it yet.
# HDH_REDIS_URL=redis://localhost:6379/0

# UMLS/UTS API key for `hdh snomed load --download` (SNOMED CT US Edition).
# Personal credential from https://uts.nlm.nih.gov (My Profile) under the free
# UMLS Metathesaurus License. SNOMED CT data is licensed: it downloads to
# ~/.hdh/snomed/ for YOUR use and must never be committed or redistributed.
# UMLS_API_KEY=

# ── Media I/O service (`hdh serve-media`, port 8200) — the encounter workflow ──
# Which transducer backend the media service runs. Default null = an ECHO (stub
# text, no GPU) that exercises the UI plumbing; local = real NeMo STT + Kokoro
# TTS + docTR OCR (needs the `hdh[media]` extra and a CUDA GPU); aws = managed
# Transcribe/Polly/Textract (needs `hdh[aws]` + creds, HIPAA under a BAA).
# You can also pass this per run: `hdh serve-media --backend local`.
# HDH_MEDIA_BACKEND=null
# HDH_MEDIA_STT=nemo              # local async engine: nemo (default) | whisperx

# AWS managed media route (only when HDH_MEDIA_BACKEND=aws). HIPAA-eligible ONLY
# under a BAA. STT runs a batch Transcribe Medical job (upload→poll→fetch), so
# it needs an S3 bucket for input; Polly (TTS) and Textract (OCR) need no bucket.
# See docs/guides/encounter-testing.md (Cycle C).
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# HDH_AWS_TRANSCRIBE_BUCKET=        # S3 bucket Transcribe reads input from (STT)
# HDH_AWS_TRANSCRIBE_TYPE=CONVERSATION   # CONVERSATION (diarized) | DICTATION
# HDH_AWS_MAX_SPEAKERS=2            # speaker labels to ask Transcribe for
