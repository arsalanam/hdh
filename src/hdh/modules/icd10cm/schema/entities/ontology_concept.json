  "semantics": {
    "purpose": "One code in a terminology — ICD-10-CM, SNOMED CT, LOINC or RxNorm — with its description.",
    "also_called": [
      "codes",
      "terminology",
      "the code list"
    ],
    "use_when": "Rarely by SQL. Prefer the icd/snomed/loinc/rxnorm tools: they know each vocabulary's rules, and this table cannot answer subsumption at all.",
    "columns": {
      "path": "ICD-10-CM only. It is NOT populated for other vocabularies, so a hierarchy query written against it silently returns nothing for SNOMED."
