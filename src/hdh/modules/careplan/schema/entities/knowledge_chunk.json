    {"name": "corpus", "type": "String", "length": 60, "nullable": false},
    {"name": "doc_id", "type": "String", "length": 200, "nullable": false},
    {"name": "chunk_index", "type": "Integer", "nullable": false},
    {"name": "text", "type": "Text", "nullable": false},
    {"name": "source", "type": "String", "length": 300, "nullable": false},
    {"name": "license", "type": "String", "length": 100, "nullable": false},
    {"name": "chunk_metadata", "type": "JSON"},
    {"name": "content_hash", "type": "String", "length": 64, "nullable": false},
    {"name": "ingested_at", "type": "DateTime"}
