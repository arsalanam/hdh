{
  "entity": "CarePlanRecord",
  "tablename": "care_plan_records",
  "module": "careplan_module",
  "columns": [
    {"name": "id", "type": "Integer", "primary_key": true, "autoincrement": true},
    {"name": "patient_id", "type": "Integer", "foreign_key": "patients.id", "nullable": false},
    {"name": "title", "type": "String", "length": 200, "nullable": false},
    {
      "name": "status",
      "type": "Enum",
      "values": [
        "draft",
        "ai_generated",
        "auto_evaluated",
        "pending_review",
        "user_edited",
        "approved",
        "rejected"
      ],
      "nullable": false
    },
    {"name": "narrative", "type": "Text"},
    {"name": "rejection_reason", "type": "String", "length": 300},
    {"name": "checkpoint_thread_id", "type": "String", "length": 100},
    {"name": "created_at", "type": "DateTime"},
    {"name": "updated_at", "type": "DateTime"}
  ],
  "indexes": [
    {"name": "ix_care_plan_patient", "columns": ["patient_id"]},
    {"name": "ix_care_plan_status", "columns": ["status"]}
  ]
}
